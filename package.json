{
  "name": "budgey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build --configLoader runner && esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.js",
    "start": "node --env-file=.env dist/server.js",
    "migrate": "node --import tsx server/migrate.ts",
    "seed": "node --import tsx server/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:pg-standalone": "python3 scripts/test-postgres-standalone.py",
    "seed:wealth": "node --import tsx scripts/seed-wealth-demo.ts",
    "test:wealth:api": "node --import tsx tests/wealth-api.ts",
    "test:wealth:browser": "node scripts/test-wealth-browser.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^3.25.0",
    "csv-parse": "^6.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vite": "^6.3.0",
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.5.0"
  },
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=9"
  }
}
